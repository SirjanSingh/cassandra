# Cassandra settings. Copy to .env, or set as real environment variables (those win).
# Only needed for the claim-by-claim check (`--llm`) and `cassandra serve`.

# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL empty for OpenAI itself.
OPENAI_API_KEY=sk-replace-me
# OPENAI_BASE_URL=https://openrouter.ai/api/v1        # OpenRouter
# OPENAI_BASE_URL=http://localhost:11434/v1           # local Ollama (data never leaves)
CASSANDRA_MODEL=gpt-4o-mini                           # the benchmarked default

# Parallel LLM calls during a scan.
CASSANDRA_CONCURRENCY=8

# `cassandra serve` only
# CASSANDRA_API_KEY=choose-a-long-random-string       # require Authorization: Bearer <key>
# CASSANDRA_SPEC_FILE=spec.json                       # tool-call spec for every request
